# ═══════════════════════════════════════════════════════════════
#  LIBITUM — Plantilla de variables para PRODUCCIÓN (ej. Railway)
#  Copia estas claves en el panel de tu hosting. NO subir el .env real.
# ═══════════════════════════════════════════════════════════════

APP_NAME=Libitum
APP_ENV=production                 # ← producción, no "local"
APP_KEY=                           # ← genera con: php artisan key:generate --show
APP_DEBUG=false                    # ← FALSE en producción (no filtrar trazas de error)
APP_URL=https://TU-BACKEND.up.railway.app   # ← URL pública real del backend

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=error                    # ← solo errores en producción (no "debug")

# ── Base de datos (Neon / Railway Postgres) ──
DB_CONNECTION=pgsql
DB_HOST=                           # ← host de tu Postgres gestionado
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Neon requiere SSL:
# DB_SSLMODE=require

# ── Sesión / Sanctum (SPA en otro dominio) ──
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true         # ← cookies solo por HTTPS
SESSION_DOMAIN=.tudominio.com      # ← dominio raíz compartido front/back (si aplica)
SANCTUM_STATEFUL_DOMAINS=tu-frontend.vercel.app
FRONTEND_URL=https://tu-frontend.vercel.app

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Email real (recordatorios de eventos) ──
# Cambia de "log" a un SMTP real (SendGrid, Mailgun, Resend, etc.)
MAIL_MAILER=smtp
MAIL_HOST=                         # ej. smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@tudominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Google Maps ──
VITE_GOOGLE_MAPS_KEY="TU_API_KEY_DE_PRODUCCION"   # restringe la key por dominio en Google Cloud

# ═══════════════════════════════════════════════════════════════
#  Tras desplegar, en el servidor:
#    php artisan migrate --force
#    php artisan config:cache && php artisan route:cache
#  Cron para los recordatorios de email (cada minuto):
#    * * * * * php artisan schedule:run
# ═══════════════════════════════════════════════════════════════
